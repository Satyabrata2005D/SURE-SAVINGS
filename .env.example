# SURE SAVINGS Environment Configuration Template
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
SESSION_SECRET=generate-a-secure-random-64-character-string
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://127.0.0.1:8000
DATABASE_URL=sqlite:///sure_savings.db
ENVIRONMENT=development

# SMTP Email OTP Service (e.g. Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-google-16-char-app-password
SMTP_FROM_NAME="SURE SAVINGS"

# Setu Account Aggregator (AA) Gateway Configuration
# Obtain sandbox credentials from https://bridge.setu.co/v2
# NOTE: If SETU_PRODUCT_INSTANCE_ID is blank or credentials are not yet configured,
# SURE SAVINGS automatically runs in local Account Aggregator Sandbox Simulator mode,
# allowing full end-to-end evaluation without external HTTP 500 errors.
SETU_CLIENT_ID=your-setu-client-id
SETU_CLIENT_SECRET=your-setu-client-secret
SETU_PRODUCT_INSTANCE_ID=your-setu-product-instance-id
SETU_ENVIRONMENT=sandbox
SETU_BASE_URL=https://fiu-sandbox.setu.co

# Gemini AI Configuration (SURE AI Natural Language Guidance & Explanation Layer)
# Obtain your restricted API key from Google AI Studio: https://aistudio.google.com/
# NOTE: Server routes queries through backend API. API key is NEVER exposed client-side.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash


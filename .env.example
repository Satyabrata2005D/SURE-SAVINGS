# SURE SAVINGS Environment Configuration Template
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
SESSION_SECRET=generate-a-secure-random-64-character-string
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://127.0.0.1:8000
DATABASE_URL=sqlite:///sure_savings.db
ENVIRONMENT=development

# SMTP Email OTP Service (e.g. Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-google-16-char-app-password
SMTP_FROM_NAME="SURE SAVINGS"
